# Copy to .env and export, or set in your shell. Everything has a sensible default.
LLM_MODEL=llama3:latest          # any model you have pulled (see `ollama ls`)
LLM_BASE_URL=http://localhost:11434
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
WHISPER_MODEL=base.en            # tiny.en (fastest) | base.en | small.en (most accurate)
RERANK=0                         # 1 = cross-encoder re-ranking (extra ~90 MB model)
MIN_DENSE_SIM=                   # leave empty for the embedder's default; tune with `python -m eval.run_eval`
ALLOWED_ORIGINS=*                # in production: https://your-portfolio-domain
GITHUB_USER=kavya1b1

LLM_TIMEOUT_SECONDS=90
MAX_HISTORY_TURNS=6
MAX_GRAPH_STEPS=12
